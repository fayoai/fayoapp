{
  "name": "mif-smart-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "MIF Smart secure cross-platform desktop wrapper",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mifsmart.desktop",
    "productName": "MIF Smart",
    "directories": {"output": "release"},
    "files": ["main.mjs","desktop-config.json","package.json"],
    "asar": true,
    "mac": {"category": "public.app-category.business", "target": ["dmg","zip"]},
    "win": {"target": ["nsis","portable"]},
    "linux": {"target": ["AppImage","deb"],"category":"Office"}
  }
}

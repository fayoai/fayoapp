{
  "name": "mif-smart-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch api/dev-server.mjs\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test api/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@neondatabase/serverless": "^1.0.2",
    "hono": "^4.9.10",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7",
    "wrangler": "^4.40.0"
  }
}

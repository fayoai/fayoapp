{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawi-enterprise",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {"binding": "AI"},
  "vars": {
    "MIF_APP_SURFACE": "enterprise",
    "PUBLIC_CHAT_ENABLED": "true",
    "NEON_PROJECT_ID": "withered-night-28458135",
    "LEGACY_NEON_PROJECT_ID": "blue-wave-63999494",
    "LEGACY_NEON_BRANCH_ID": "br-still-recipe-b9xl70wg",
    "NEON_BRANCH_ID": "br-bitter-dust-b99el76s",
    "NEON_DB_ROLE_NAME": "rawi_control_owner"
  },
  "assets": {
    "directory": "./dist/enterprise",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/api/*",
      "/developer/*",
      "/mif",
      "/mif/*",
      "/admin",
      "/admin/*",
      "/owner-setup",
      "/sitemap.xml"
    ]
  }
}

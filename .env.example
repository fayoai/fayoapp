# Server-side only. Set secrets using `npx wrangler secret put` on Cloudflare.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SESSION_SECRET=replace-with-strong-random-at-least-32-characters
ADMIN_BOOTSTRAP_TOKEN=replace-with-separate-strong-random-token
SITE_ORIGIN=https://your-domain.example
PORT=8788

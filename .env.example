# MIF Smart SaaS (company) + RAWI (product) — server-side settings only
# Never commit real values, and never put secrets in VITE_* variables.
# On Cloudflare configure with Wrangler secrets or the hosting dashboard.
DATABASE_URL=postgresql://user:password@your-neon-host/db?sslmode=require
SESSION_SECRET=generate-a-unique-secret-of-at-least-32-characters
CONNECTOR_ENCRYPTION_KEY=generate-an-independent-secret-of-at-least-32-characters
ADMIN_BOOTSTRAP_TOKEN=generate-a-unique-bootstrap-token-at-least-24-characters
PLATFORM_OWNER_EMAIL=owner@example.com
SITE_ORIGIN=https://your-production-domain.example

# Registration stays off until real production security and email verification are ready.
REGISTRATION_ENABLED=false
# Only affects internal evaluation message quota; not provider credits or billing.
RAWI_TRIAL_DAYS=7
RAWI_TRIAL_MESSAGE_LIMIT=30
# Keep public/anonymous AI disabled unless explicit operator approval.
PUBLIC_CHAT_ENABLED=false

# AI providers: configure only the services you use. Free tiers belong to provider accounts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Cloudflare Workers AI requires an explicit AI binding, not an API key.

# Verified transactional email is needed for production account verification.
RESEND_API_KEY=
MAIL_FROM=
PORT=8788

# Optional native-packaged application API URL.
# VITE_API_BASE_URL=https://your-production-domain.example
# ALLOWED_APP_ORIGINS=capacitor://localhost,https://localhost,http://localhost

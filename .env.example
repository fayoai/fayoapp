# Server-side only. Set secrets using `npx wrangler secret put` on Cloudflare.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SESSION_SECRET=replace-with-strong-random-at-least-32-characters
ADMIN_BOOTSTRAP_TOKEN=replace-with-separate-strong-random-token
SITE_ORIGIN=https://your-domain.example
PORT=8788
# MIF Smart Commerce (server-only; do not expose to Vite)
MOYASAR_SECRET_KEY=sk_test_replace-with-test-key
# SITE_ORIGIN must be your actual public HTTPS origin for hosted payment callbacks.
# Optional Cloudflare R2 binding MODULE_FILES enables private Odoo module ZIP uploads/downloads.

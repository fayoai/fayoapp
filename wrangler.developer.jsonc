{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawi-developer",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MIF_APP_SURFACE": "developer"
  },
  "assets": {
    "directory": "./dist/developer",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/api/*",
      "/developer",
      "/developer/*",
      "/mif",
      "/mif/*",
      "/owner-setup",
      "/sitemap.xml"
    ]
  }
}

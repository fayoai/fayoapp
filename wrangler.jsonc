{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mif-smart-platform",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist/mif",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/developer",
      "/developer/",
      "/mif",
      "/mif/*",
      "/sitemap.xml",
      "/"
    ]
  },
  "vars": {
    "MIF_APP_SURFACE": "mif",
    "RAWI_ENTERPRISE_ORIGIN": "https://rawi-enterprise.fayosaas.workers.dev",
    "RAWI_DEVELOPER_ORIGIN": "https://rawi-developer.fayosaas.workers.dev"
  }
}

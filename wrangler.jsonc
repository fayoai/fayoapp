{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mif-smart-platform",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist/mif",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mif",
      "/mif/*",
      "/sitemap.xml",
      "/",
      "/developer/*"
    ]
  },
  "ai": {"binding": "AI"},
  "vars": {
    "MIF_APP_SURFACE": "mif",
    "RAWI_ENTERPRISE_ORIGIN": "https://rawi-enterprise.fayosaas.workers.dev",
    "NEON_PROJECT_ID": "blue-wave-63999494",
    "NEON_BRANCH_ID": "br-still-recipe-b9xl70wg",
    "NEON_DB_ROLE_NAME": "mif_smart_owner"
  }
}

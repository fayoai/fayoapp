{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mif-smart-platform",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mif",
      "/mif/*",
      "/developers",
      "/developers/*"
    ]
  }
}
